# AURIX Backend Environment Configuration

PORT=3000
NODE_ENV=development

# Supabase Configuration
# Obtain from https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Upstash Redis Configuration (Optional - fallback scanner used if not provided)
UPSTASH_REDIS_URL=

# GitHub Configuration (Optional for automated PRs)
GITHUB_TOKEN=

# Frontend Base URL
FRONTEND_URL=http://localhost:5173

# Auth Strictness (false allows sandbox fallback for unauthenticated demo sessions)
STRICT_AUTH=false
